# Database (Neon PostgreSQL - Cloud Database)
# Create a free project at https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk Authentication (Get your keys from https://clerk.com/)
# Sign up, create an app, and copy your keys from the dashboard
CLERK_SECRET_KEY=sk_test_xxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Groq AI API Key — https://console.groq.com/keys (free tier available)
GROQ_API_KEY=gsk_xxxxxxxx

# Google Gemini AI API Key (Free tier: 60 requests/minute)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=xxxxxxxx

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Client Configuration
VITE_API_URL=http://localhost:5000
