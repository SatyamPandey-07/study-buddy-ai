{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm install --include=dev && prisma generate && vite build",
  "installCommand": "npm install --include=dev",
  "functions": {
    "api/index.ts": {
      "includeFiles": ".prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}